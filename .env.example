# WhatsApp session ID received after pairing; required for the main bot session
SESSION_ID=
# Optional phone number for automatic pairing; include country code and digits only
PHONE=
# Optional command prefix (default: .)
PREFIX=.
# Optional owner phone number; include country code and digits only
OWNER_NUMBER=
# Optional YouTube cookies.txt content or file path
YT_COOKIES=
# Optional OpenAI-compatible AI provider settings
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional OMDb API key for movie information
OMDB_KEY=
# Allow commands without a prefix (default: true)
NOPREFIX_ALL=true
