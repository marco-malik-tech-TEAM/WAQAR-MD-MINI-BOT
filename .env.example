# Legacy compatibility only; leave blank. Use website pairing plus persistent /app/sessions_active storage.
SESSION_ID=
# Direct main-account pairing only; leave blank when pairing this number through /pair
PHONE=
# Optional command prefix (default: .)
PREFIX=.
# Optional owner phone number; include country code and digits only
OWNER_NUMBER=
# Optional yt-dlp cookies.txt path or content for YouTube sign-in challenges; keep private
YT_COOKIES=

# AI chatbot providers: auto | gemini | openai | custom
AI_PROVIDER=auto
# Optional: true enables or false disables auto-chat; if blank, a configured API key enables it
AI_AUTO_CHAT=
# Reply to ordinary text in both private chats and groups; false limits it to private chats
AI_AUTO_CHAT_GROUPS=true
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible API (e.g. OpenRouter or another compatible endpoint)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional OMDb API key for movie information
OMDB_KEY=
# Allow commands without a prefix (default: true)
NOPREFIX_ALL=true
# WhatsApp channel code used by the project
CHANNEL_CODE=0029VbE1PSOGzzKS8DCvLM32
